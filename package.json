{
  "name": "re-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "@re — minimal, fastest, most robust frontend framework with native-level DX (Web Components + fine-grained signals + tagged templates) and a Zig-powered template precompiler.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bench:serve": "node bench/server.mjs",
    "bench:verify": "node bench/harness/verify.mjs",
    "bench:run": "node bench/harness/run.mjs",
    "bench:report": "node bench/harness/report.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "acorn": "^8.19.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^17.0.0",
    "magic-string": "^1.4.3",
    "parse5": "^8.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
